# Vibe Monitor Environment Variables
# Copy this file to .env.local and fill in the values

# Configure the HTTPS Web origin and read token in Settings > Connections.
# Read tokens are encrypted by OS secure storage, not saved in this file.

# Hook installer docs base URL (advanced; custom installer deployments)
# Default: https://vibemon.io/install
# VIBEMON_DOCS_URL="https://vibemon.io/install"

# SHA-256 the downloaded install.py is verified against before it runs
# (advanced; must match the installer served by VIBEMON_DOCS_URL)
# VIBEMON_INSTALLER_SHA256=
