{
  "name": "vibemon",
  "version": "3.8.12",
  "description": "AI assistant status monitor",
  "engines": {
    "node": ">=26.11.1 <27"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:dmg": "electron-builder --mac dmg --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "electron-builder --mac --win --linux --publish never",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:overlays": "electron tests/native/overlay-smoke.cjs",
    "test:hit-testing": "electron tests/native/hit-test-smoke.cjs",
    "test:workspace": "node tests/native/run-workspace.cjs",
    "preview:workspace": "node tests/native/run-workspace.cjs --preview",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check:registry": "node scripts/check-registry.mjs",
    "check:distribution": "node scripts/export-web.mjs",
    "build:distribution": "node scripts/export-web.mjs --write",
    "test:design": "node --test tests/*.test.mjs",
    "preview:widgets": "node scripts/preview-widgets.mjs"
  },
  "author": "nalbam",
  "license": "MIT",
  "keywords": [
    "vibemon",
    "claude-code",
    "codex",
    "kiro",
    "openclaw",
    "opencode",
    "ai-assistant",
    "status-monitor",
    "electron",
    "pixel-art"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opspresso/vibemon-app.git"
  },
  "homepage": "https://opspresso.github.io/vibemon-app/",
  "bugs": {
    "url": "https://github.com/opspresso/vibemon-app/issues"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "electron": "^43.7.9",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "three": "^0.185.1"
  },
  "build": {
    "appId": "com.opspresso.vibemon",
    "productName": "VibeMon",
    "files": [
      "src/**",
      "assets/icon*",
      "LICENSE",
      "package.json"
    ],
    "beforePack": "./scripts/macos-widgets-packaging.cjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extraFiles": [
        {
          "from": "build/macos-widgets/Release/VibeMonWidgets.appex",
          "to": "PlugIns/VibeMonWidgets.appex"
        }
      ],
      "extraResources": [
        {
          "from": "build/macos-widgets/Release/widget-center.node",
          "to": "widget-center.node"
        }
      ],
      "sign": "./scripts/macos-widgets-packaging.cjs",
      "protocols": [
        {
          "name": "VibeMon",
          "schemes": [
            "vibemon"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "opspresso",
        "repo": "vibemon-app"
      }
    ]
  },
  "packageManager": "pnpm@12.10.1",
  "private": true
}
